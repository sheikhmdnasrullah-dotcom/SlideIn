# Acquisition OS — Environment Configuration

# Database
DATABASE_URL=postgresql+asyncpg://acquisition:acquisition@localhost:5432/acquisition_os

# LLM Providers (at least one required)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Infrastructure Integration (owned by infra agent)
INFRA_SEND_URL=http://localhost:8001/v1/send
INFRA_DOMAIN_VERIFY_URL=http://localhost:8001/v1/domains/verify
INFRA_CALENDAR_URL=http://localhost:8001/v1/calendar
INFRA_ANALYTICS_URL=http://localhost:8001/v1/analytics

# Redis (for workers)
REDIS_URL=redis://localhost:6379

# Application
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Field-level encryption for sensitive columns (calendar credentials).
# Fernet key: URL-safe base64 encoding of 32 bytes. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# REQUIRED when ENVIRONMENT=production; in dev/test a fixed built-in
# development key is used and a warning is logged.
PRODUCT_FIELD_ENCRYPTION_KEY=
