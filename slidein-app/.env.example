# Slidein Client Workspace — Environment Configuration

# API connection (server-side only — never expose the key to the browser)
# slidein-api must be reachable from the server at this URL.
SLIDEIN_API_URL=http://127.0.0.1:8100
SLIDEIN_API_KEY=
SLIDEIN_WORKSPACE_ID=ten_local

# Auth mode: "enforced" (default, requires a valid API key) or "disabled"
# (local development only — resolves every request to the first configured
#  workspace as admin).
SLIDEIN_AUTH_MODE=enforced
