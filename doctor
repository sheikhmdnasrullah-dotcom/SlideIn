# ANSI Colors
GREEN = "\033[92m"
RED = "\033[91m"
YELLOW = "\033[93m"
CYAN = "\033[96m"
BOLD = "\033[1m"
RESET = "\033[0m"


def check_port(host: str, port: int, timeout: float = 1.0) -> bool:
    try:
        with socket.create_connection((host, port), timeout=timeout):
            return True
    except (socket.timeout, ConnectionRefusedError, OSError):
        return False


def run_command(cmd: list[str]) -> tuple[int, str]:
    try:
        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, timeout=5)
        return res.returncode, res.stdout.strip()
    except Exception as e:
        return 1, str(e)


def find_processes(marker: str) -> list[int]:
    """Return PIDs whose command line matches marker (path-scoped, ERE)."""
    try:
        res = subprocess.run(["pgrep", "-f", marker], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=5)
        if res.returncode != 0:
            return []
        return [int(p) for p in res.stdout.split() if p.strip()]
    except Exception:
        return []


def process_command(pid: int) -> str:
    try:
        res = subprocess.run(["ps", "-o", "command=", "-p", str(pid)], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=5)
        return res.stdout.strip()
    except Exception:
        return ""


def print_row(component: str, status: str, details: str, port: str = "-"):
    color = GREEN if status == "HEALTHY" else (YELLOW if status == "DEGRADED" or status == "ISOLATED" else RED)
    status_str = f"{color}{BOLD}{status:<12}{RESET}"
    print(f"  {component:<24} {status_str} {port:<10} {details}")


