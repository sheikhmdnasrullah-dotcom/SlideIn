# Warmbly production env for the SlideIn VPS (/opt/warmbly/.env).
# Secrets are generated on first deploy (see gen-warmbly-env.sh); this file
# documents every non-secret value. NEVER commit real secrets here.
APP_ENV=prod
DEPLOYMENT_MODE=self_hosted
AUTH_SECRET=generate-openssl-rand-hex-32
KMS_LOCAL_MASTER_KEY=generate-openssl-rand-base64-32
CREDENTIALS_ENCRYPTION_KEY=generate-openssl-rand-hex-32
INTERNAL_API_TOKEN=generate-openssl-rand-hex-32
SECRET_KEY_BASE=generate-openssl-rand-hex-48
BILLING_PROVIDER=none
WARMBLY_TAG=prod
# Host-side remaps (avoid the SlideIn stack; all loopback-bound in compose)
TRACKING_PORT=3200
FORMS_PORT=8094
# Public URLs (terminated by Caddy; DNS via Cloudflare)
TRACKING_DOMAIN=warmbly-track.slideinventure.com
APP_URL=https://warmbly.slideinventure.com
API_PUBLIC_URL=https://warmbly-api.slideinventure.com
CORS_ALLOW_ORIGINS=https://warmbly.slideinventure.com
WEBSOCKET_URL=wss://warmbly-api.slideinventure.com/socket/websocket
# KumoMTA presents a self-signed cert on the loopback relay
MAIL_TLS_INSECURE=true
# Reverse proxy in front (Caddy on host -> docker bridge gateways)
TRUSTED_PROXIES=172.16.0.0/12
# Warmbly's own notification mail rides the SlideIn KumoMTA relay
MAIL_TRANSPORT=smtp
SMTP_HOST=kumomta
SMTP_PORT=2587
SMTP_USERNAME=outbound
SMTP_PASSWORD=same-as-KUMO_AUTH_PASS-on-VPS
SMTP_SECURITY=starttls
EMAIL_NAME=SlideIn
EMAIL_ADDRESS=hello@nasrullahtanim.me
# First owner (read once while users table is empty)
WARMBLY_BOOTSTRAP_EMAIL=hello@nasrullahtanim.me
WARMBLY_BOOTSTRAP_PASSWORD=generate-openssl-rand-hex-24
