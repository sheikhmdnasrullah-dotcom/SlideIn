# Slidein API — Environment Configuration

# ── Runtime ──────────────────────────────────────────────
SLIDEIN_HOST=0.0.0.0
SLIDEIN_PORT=8100
SLIDEIN_LOG_LEVEL=info
# Set to 0 in production (no hot-reload)
SLIDEIN_RELOAD=0

# ── Authentication ──────────────────────────────────────
# JSON map of workspace → {key, role}. Generate a key per workspace:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Mode is "enforced" (require a valid bearer key) by default. Set to
# "disabled" ONLY for local development.
SLIDEIN_AUTH_MODE=enforced
SLIDEIN_API_KEYS={"ten_local":{"key":"dev-key","role":"admin"}}

# ── Business Brain (file-backed customer workspace) ────
# Root directory that holds one workspace per tenant, e.g.
#   /var/lib/slidein/workspaces/<tenant>/
# The runtime resolves the authenticated tenant to its workspace below this
# root. Never allow an arbitrary caller-supplied filesystem path.
SLIDEIN_WORKSPACE_ROOT=/var/lib/slidein/workspaces

# ── Database ────────────────────────────────────────────
# SQLite (default, file-based) or PostgreSQL for production.
# SLIDEIN_DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
# Default: sqlite+aiosqlite:///./data/slidein.db
SLIDEIN_DATABASE_URL=

# ── Integrations ────────────────────────────────────────
# KumoMTA submission endpoint (for live send path)
SLIDEIN_SMTP_HOST=127.0.0.1
SLIDEIN_SMTP_PORT=2587
SLIDEIN_SMTP_USER=outbound
SLIDEIN_SMTP_PASS=
# Transport used when a caller sends no explicit transport config (e.g. the
# Autopilot). Empty = dry_run (records the dispatch, no bytes on the wire).
# "kumo" = KumoMTA submission (falls back to KUMO_HOST/KUMO_SMTP_PORT/
# KUMO_AUTH_USER/KUMO_AUTH_PASS, then the defaults above).
# "smtp" = generic SMTP with SLIDEIN_SMTP_*.
SLIDEIN_TRANSPORT=

# ── Warmbly (14-day mailbox warmup rule) ────────────────
# The self-hosted Warmbly warmup platform installed by install.sh (Phase 12).
# With WARMBLY_URL set, live (non dry-run) campaign sends are blocked until
# every sending mailbox completes 14 days of Warmbly warmup on a domain whose
# SPF/DKIM/DMARC pass. Warmup auto-starts when initial setup saves the
# sending identity; re-sync any time with POST /v1/tenants/{id}/warmup/start.
# Loopback http is allowed; anything else must be https.
WARMBLY_URL=
# Warmbly UI -> Settings -> API keys (scopes READ_EMAILS + WRITE_EMAILS).
# Missing with WARMBLY_URL set = "cannot verify" = gate stays closed.
WARMBLY_API_TOKEN=
# auto (default) = enforce iff WARMBLY_URL is set · required = always
# enforce · off = never enforce (local development only).
SLIDEIN_WARMUP_ENFORCE=auto

# ── Durable execution ───────────────────────────────────
# inline = legacy local BackgroundTasks + API loop. celery = persisted jobs,
# one Beat scheduler, and separate workers; the API loop stays off.
SLIDEIN_EXECUTION_MODE=inline
SLIDEIN_CELERY_BROKER_URL=redis://127.0.0.1:6379/0
SLIDEIN_JOB_LEASE_SECONDS=900
SLIDEIN_JOB_BACKOFF_SECONDS=30
SLIDEIN_SCHEDULER_INTERVAL_SECONDS=30

# ── Autopilot (autonomous background agent loop) ────────
# 0 disables the loop entirely; the API still serves the dashboard.
# Enable deliberately after workspace review; transport remains dry-run by default.
SLIDEIN_AUTOPILOT=0
# Seconds between ticks across all workspaces.
SLIDEIN_AUTOPILOT_INTERVAL=300
# Prospects advanced per stage per tick.
SLIDEIN_AUTOPILOT_BATCH=10
# Dispatches per tick (sending is always gated by approval policy,
# suppression, rate limits and the deliverability guard).
SLIDEIN_AUTOPILOT_MAX_SENDS=5
# Comma-separated CSV lead files polled every tick (idempotent ingest —
# duplicates are reported, never merged).
SLIDEIN_AUTOPILOT_INGEST=
# Research connector chain tried in order per prospect.
# "orchestrated" accounts for every registered research tool and persists attempts.
SLIDEIN_AUTOPILOT_CONNECTOR=orchestrated

# Reacher recipient verification. Live sending requires a "safe" verdict.
REACHER_URL=
REACHER_SECRET=

# LLM provider keys (for persona / content generation)
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# OpenOSINT CLI (prospect OSINT enrichment — /v1/osint and research
# connector "openosint"). Install: https://github.com/OpenOSINT/OpenOSINT
OPENOSINT_CLI=openosint
# Working directory of the CLI checkout (where its own .env lives). Optional.
OPENOSINT_WORKDIR=
# 1 = allow the noisy active lookups (email/username enumeration) without a
# per-request allow_active opt-in. Leave 0 unless you accept the side effects.
OPENOSINT_ALLOW_ACTIVE=0
# Note: the username lookup shells out to `sherlock`; install it next to the
# CLI (`uv pip install sherlock-project --python <venv>/bin/python`). The
# adapter prepends the CLI's own bin dir to PATH, so a co-located install
# is picked up automatically.
