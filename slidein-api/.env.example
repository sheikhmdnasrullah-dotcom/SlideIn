# Slidein API — Environment Configuration

# ── Runtime ──────────────────────────────────────────────
SLIDEIN_HOST=0.0.0.0
SLIDEIN_PORT=8100
SLIDEIN_LOG_LEVEL=info
# Set to 0 in production (no hot-reload)
SLIDEIN_RELOAD=0

# ── Authentication ──────────────────────────────────────
# JSON map of workspace → {key, role}. Generate a key per workspace:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Mode is "enforced" (require a valid bearer key) by default. Set to
# "disabled" ONLY for local development.
SLIDEIN_AUTH_MODE=enforced
SLIDEIN_API_KEYS={"ten_local":{"key":"dev-key","role":"admin"}}

# ── Database ────────────────────────────────────────────
# SQLite (default, file-based) or PostgreSQL for production.
# SLIDEIN_DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
# Default: sqlite+aiosqlite:///./data/slidein.db
SLIDEIN_DATABASE_URL=

# ── Integrations ────────────────────────────────────────
# KumoMTA submission endpoint (for live send path)
SLIDEIN_SMTP_HOST=127.0.0.1
SLIDEIN_SMTP_PORT=2587
SLIDEIN_SMTP_USER=outbound
SLIDEIN_SMTP_PASS=

# LLM provider keys (for persona / content generation)
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# OpenOSINT CLI (prospect OSINT enrichment — /v1/osint and research
# connector "openosint"). Install: https://github.com/OpenOSINT/OpenOSINT
OPENOSINT_CLI=openosint
# Working directory of the CLI checkout (where its own .env lives). Optional.
OPENOSINT_WORKDIR=
# 1 = allow the noisy active lookups (email/username enumeration) without a
# per-request allow_active opt-in. Leave 0 unless you accept the side effects.
OPENOSINT_ALLOW_ACTIVE=0
# Note: the username lookup shells out to `sherlock`; install it next to the
# CLI (`uv pip install sherlock-project --python <venv>/bin/python`). The
# adapter prepends the CLI's own bin dir to PATH, so a co-located install
# is picked up automatically.
