# SlideIn Platform Environment Configuration Template

# Runtime Environment (local, staging, production)
SLIDEIN_ENV=local

# Application Services
SLIDEIN_ADMIN_PORT=3333
SLIDEIN_PHISH_PORT=8080
SLIDEIN_ADMIN_HOST=127.0.0.1
SLIDEIN_USE_TLS=false

# KumoMTA Submission & Admin API
KUMO_HOST=127.0.0.1
KUMO_SMTP_PORT=2587
KUMO_ADMIN_PORT=8029
KUMO_AUTH_USER=outbound
# REQUIRED: set to your KumoMTA submission password. Never commit real values.
KUMO_AUTH_PASS=

# Local Mail Sink (Mailpit)
MAILPIT_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# Redis Queue & Warmup State
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Sending Domains & Profiles
SENDING_DOMAIN=nasrullahtanim.me
SENDER_PROFILE_HELLO=hello@nasrullahtanim.me
SENDER_PROFILE_TALK=talk@nasrullahtanim.me
SENDER_PROFILE_CONNECT=connect@nasrullahtanim.me

# Storage
DATABASE_DRIVER=sqlite3
DATABASE_PATH=gophish.db
DELIVERABILITY_STATE_PATH=deliverability/deliverability_state.db

# OpenRouter / LLM (Optional)
OPENROUTER_API_KEY=

# Inbound webhook receiver (deliverability/webhook_server.py)
# REQUIRED for /webhook/sendgrid|postmark|mailgun|generic: requests without a
# valid HMAC signature are rejected, and routes refuse traffic (503) when unset.
WEBHOOK_SECRET=
# Optional comma-separated SNS TopicArn allowlist for /webhook/ses.
SNS_TOPIC_ARNS=
